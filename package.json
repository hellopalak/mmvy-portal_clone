{
  "name": "mmvy-shared-portal",
  "version": "1.0.0",
  "private": true,
  "description": "MMVY application portal, partner portal and API Setu lookup service backed by PostgreSQL.",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "server:dev": "node --watch server/server.js",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "db:init": "node db/init.js",
    "db:local:start": "node db/local-postgres.js start",
    "db:local:stop": "node db/local-postgres.js stop",
    "db:cdc:listen": "node db/cdc-listener.js",
    "test:e2e": "node scripts/e2e-check.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  }
}
